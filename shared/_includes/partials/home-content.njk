<div class="container">
  {% if pagination.pageNumber == 0 %}
  {% if collections.featuredPosts.length > 0 %}
  <section class="featured-area" aria-label="Featured posts">
    {% set featured = collections.featuredPosts | head(1) %}
    {% for post in featured %}
    <article class="featured-slide" style="background-image: url('{{ post.data.image or images.defaultPost or site.placeholderImage }}')">
      <div class="featured-overlay">
        <div class="featured-cats">
          {% for cat in post.data.categories %}
          <a href="/categories/{{ cat | slugify }}/">{{ cat }}</a>
          {% endfor %}
        </div>
        <h2 class="featured-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <a href="{{ post.url }}" class="featured-more">Read More</a>
      </div>
    </article>
    {% endfor %}
  </section>
  {% endif %}

  {% if site.homeShop %}
  <section class="home-shop-preview" aria-labelledby="home-shop-title">
    <div class="home-shop-heading">
      <span></span>
      <h2 id="home-shop-title">{{ site.homeShop.title }}</h2>
      <span></span>
    </div>
    <div class="home-shop-items">
      {% for item in site.homeShop.items %}
      <a href="{{ item.url }}" class="home-shop-item" target="_blank" rel="noopener sponsored">
        <img src="{{ item.image }}" alt="{{ item.name }}" loading="lazy">
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if site.promoBoxes and site.promoBoxes.length %}
  <section class="promo-area" aria-label="Featured pages">
    {% for box in site.promoBoxes %}
    <div class="promo-item" style="background-image: url('{{ box.image }}')">
      <a href="{{ box.url }}" class="promo-link" aria-label="{{ box.title }}"></a>
      <div class="promo-overlay">
        <h4>{{ box.title }}</h4>
      </div>
    </div>
    {% endfor %}
  </section>
  {% endif %}
  {% endif %}

  <div id="main-layout">
    <section aria-label="Latest posts">
      <div class="post-grid">
        {% for post in posts %}
        {% include "partials/post-card.njk" %}
        {% endfor %}
      </div>

      {% if pagination.href.previous or pagination.href.next or pagination.pages.length > 1 %}
      {% include "partials/pagination.njk" %}
      {% endif %}
    </section>
  </div>
</div>
