<article class="post-card">
  {% set postImage = post.data.image or images.defaultPost %}
  {% if postImage %}
  <div class="post-card-image">
    <a href="{{ post.url }}">
      <img src="{{ postImage }}" alt="{{ post.data.imageAlt or post.data.title }}" loading="lazy">
    </a>
  </div>
  {% endif %}
  <div class="post-card-body">
    {% if post.data.categories %}
    <div class="post-card-cats">
      {% for cat in post.data.categories %}
      <a href="/categories/{{ cat | slugify }}/">{{ cat }}</a>
      {% endfor %}
    </div>
    {% endif %}
    <h2 class="post-card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <time class="post-card-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
    {% if post.data.description %}
    <p class="post-card-excerpt">{{ post.data.description }}</p>
    {% endif %}
    <a href="{{ post.url }}" class="read-more">Read More</a>
  </div>
</article>
